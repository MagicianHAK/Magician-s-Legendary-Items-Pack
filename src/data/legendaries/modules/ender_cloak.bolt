function legendaries:ender_cloak/give:
    # Gives @s Ender Cloak

    give @s netherite_chestplate[enchantments={"protection":4},unbreakable={},custom_data={legendary:1b, ender_cloak:1b},attribute_modifiers=[{id:"5ece2df2-6d5f-4dd5-9fa0-d3070a184054",type:"armor",amount:8,operation:"add_value",slot:"chest"},{id:"464ca795-cada-4a22-972f-c666fc44b6c9",type:"armor_toughness",amount:3,operation:"add_value",slot:"chest"},{id:"8ee3b020-b2ab-4e2a-bd6a-67cf48fd4d2b",type:"knockback_resistance",amount:.1,operation:"add_value",slot:"chest"},{id:"46922099-2e3d-48d1-86d8-1348fa7f053f",type:"max_health",amount:4,operation:"add_value",slot:"chest"}],custom_name={"bold":true,"color":"dark_purple","italic":false,"text":"Ender Cloak"},lore=[" ",{"color":"light_purple","italic":false,"text":"Having a legendary like this one gives permanent glowing."},{"color":"light_purple","italic":false,"text":"Grants permanent strength and 2 extra hearts while"},{"color":"light_purple","italic":false,"text":"wearing."}," ",[{"bold":true,"color":"dark_purple","italic":false,"text":"Ender Step: "},{"bold":false,"color":"dark_gray","italic":false,"text":f"(Cooldown: {cooldown_text})"}],{"color":"light_purple","italic":false,"text":"Right click with an Ender Conduit to teleport behind the"},{"color":"light_purple","italic":false,"text":f"entity you are looking at. Then deal {damage_boost}x damage on"},{"color":"light_purple","italic":false,"text":"your next attack."}],equippable={slot:"chest",equip_sound:"item.armor.equip_netherite",asset_id:"legendary_items:legendary"},item_model="legendary_items:ender_cloak"] 1


function legendaries:ender_cloak/setup:
    # Runs all setup for Ender Cloak

    # Sets up all Ender Cloak scoreboards
    scoreboard objectives add ender_cloak_raycast dummy
    scoreboard objectives add ender_cloak_cooldown dummy
    scoreboard objectives add ender_cloak_cooldown_seconds dummy

    # Max distance Ender Cloak ability works from (set in raycast function)
    scoreboard players add $enderCloakMaxRaycast ender_cloak_raycast 0


function legendaries:ender_cloak/tick:
    
    execute as @a[predicate=legendaries:wearing_ender_cloak]:

        # Gives all players without one a cooldown score
        scoreboard players add @s ender_cloak_cooldown 0

        # Applies strength to all players wearing Ender Cloak
        effect give @s strength 1 0 true

        # Gives all players who have ender cloak a ender conduit if they dont have one
        unless predicate legendaries:has_ender_conduit_in_inventory unless predicate legendaries:has_ender_conduit_in_cursor unless predicate legendaries:has_ender_conduit_in_offhand run give @s netherite_pickaxe[!tool,!attribute_modifiers,!max_damage,!damage_resistant,custom_name={"color":"dark_purple","italic":false,"text":"Ender Conduit"},custom_data={ender_conduit:1b},item_model="legendary_items:ender_conduit",consumable={consume_seconds:1000000,animation:"none",has_consume_particles:false}] 1

    # Kills all dropped ender conduits
    execute as @e[type=minecraft:item] if data entity @s Item.components."minecraft:custom_data".ender_conduit run kill @s

    # Reduce cooldown
    execute as @a[tag=ender_cloak_on_cooldown]:

        # Reduce all players cooldown by 1 tick
        scoreboard players remove @s ender_cloak_cooldown 1

        # If cooldown is over
        if score @s ender_cloak_cooldown matches 0:

            # Take Ender Cloak off cooldwon
            tag @s remove ender_cloak_on_cooldown

            # Tell player
            tellraw @s ["",{color:"dark_purple",bold:true,text:"Ender Step "},{color:"light_purple",text:"is ready!"}]


function legendaries:ender_cloak/ability:

    # Clear the trigger advancment
    advancement revoke @s only legendaries:use_ender_cloak_ability

    # Exits if the player is not wearing Ender Cloak
    execute unless predicate legendaries:wearing_ender_cloak run return fail

    # If the player is not on cooldown
    if score @s ender_cloak_cooldown matches 0:

        # Tag the player raycasting
        tag @s add ender_cloak_raycaster

        # Max distance of the raycast (number of blocks * 10)
        scoreboard players set $enderCloakMaxRaycast ender_cloak_raycast tp_range

        # Starts the raycast
        execute anchored eyes positioned ^ ^ ^.1 run function legendaries:ender_cloak/raycast

        # Removes tag
        tag @s remove ender_cloak_raycaster


function legendaries:ender_cloak/raycast:

    # Removes 1 from the max distance for every .1 blocks traveled
    scoreboard players remove $enderCloakMaxRaycast ender_cloak_raycast 1

    # Checks if the raycast hit a entity
    execute positioned ~-.5 ~-.5 ~-.5 as @e[dx=0, tag=!ender_cloak_raycaster, type=!item] run return:

        # Puts raycasting player on cooldown
        execute as @a[tag=ender_cloak_raycaster]:
            tag @s add ender_cloak_on_cooldown
            scoreboard players set @s ender_cloak_cooldown cooldown

        # Tps the raycasting player behind the target
        execute at @s anchored eyes positioned ^ ^ ^-1 run tp @a[tag=ender_cloak_raycaster] ~ ~ ~ facing entity @s

        # Gives raycasting player temp damage buff
        execute as @a[tag=ender_cloak_raycaster]:

            # Apply damage buff
            attribute @s attack_damage modifier add legendaries:ender_cloak_damage_boost damage_boost_mult add_multiplied_total
            tag @s add ender_cloak_damage_boost

            # Schedule clearing the damage buff
            schedule function legendaries:ender_cloak/clear_damage_boost damage_boost_duration_ticks

            # Cosmetic effects
            playsound entity.player.teleport master @a ~ ~ ~
            particle minecraft:dragon_breath ~ ~1 ~ 0.7 0.7 0.7 .05 150

    # Runs the next step of the raycast if it has not hit its limit and has not hit a block
    execute if block ~ ~ ~ #legendaries:ender_cloak_tp_through if score $enderCloakMaxRaycast ender_cloak_raycast matches 1.. positioned ^ ^ ^.1 run function legendaries:ender_cloak/raycast


function legendaries:ender_cloak/clear_damage_boost:

    # Clears the Ender Cloak damage boost from all players
    execute as @a[tag=ender_cloak_damage_boost] run function legendaries:ender_cloak/clear_damage_boost_self


function legendaries:ender_cloak/clear_damage_boost_self:

    # Clears the Ender Cloak damage boost from @s
    advancement revoke @s only legendaries:ender_cloak_hit_entity

    # Cancel if player dosnt have damage boost
    if entity @s[tag=!ender_cloak_damage_boost] run return fail

    attribute @s attack_damage modifier remove legendaries:ender_cloak_damage_boost
    tag @s remove ender_cloak_damage_boost

    # Tell the player
    tellraw @s ["",{color:"dark_purple",bold:true,text:"Ender Step "},{color:"light_purple",text:"damage boost is over."}]