import math

# Settings
cooldown_seconds = 60 # Seconds
tp_range_blocks = 80 # Blocks
damage_boost = 2.5
damage_boost_duration = 4

# Settings converted for use in code
tp_range = tp_range_blocks * 10
damage_boost_mult = damage_boost - 1
damage_boost_duration_ticks = damage_boost_duration * 20
cooldown = cooldown_seconds * 20

# For displaying the proper cooldown in item description
cooldown_text = f"{cooldown_seconds} Seconds"
if cooldown_seconds > 60:
    minutes = math.floor(cooldown_seconds / 60)
    seconds = cooldown_seconds % 60
    cooldown_text = f"{minutes} Minute"
    if minutes > 1:
        cooldown_text += "s"
    if seconds != 0:
        cooldown_text += f" {seconds} Second"
        if seconds > 1:
            cooldown_text += "s"

advancement legendaries:use_ender_cloak_ability {
    "criteria": {
        "using_item": {
            "trigger": "minecraft:using_item",
            "conditions": {
                "item": {
                    "predicates": {
                        "minecraft:custom_data": "{ender_conduit:1b}"
                    }
                }
            }
        }
    },
    "rewards": {
        "function": "legendaries:ender_cloak/ability"
    }
}
advancement legendaries:ender_cloak_hit_entity {
    "criteria": {
        "hit_entity": {
            "trigger": "minecraft:player_hurt_entity",
            "conditions": {
                "damage": {
                    "blocked": false
                }
            }
        }
    },
    "rewards": {
        "function": "legendaries:ender_cloak/clear_damage_boost_self"
    }
}
predicate legendaries:wearing_ender_cloak {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "slots": {
            "armor.chest": {
                "predicates": {
                    "minecraft:custom_data": {
                        "ender_cloak": true
                    }
                }
            }
        }
    }
}
