import legendaries:tidal_blade as tidal_blade
import legendaries:ancient_helm as ancient_helm
import legendaries:earthen_belt as earthen_belt
import legendaries:ender_cloak as ender_cloak
import legendaries:frenzy as frenzy
import legendaries:tempest_boots as tempest_boots
import legendaries:storms_edge as storms_edge

# Genral predicates
predicate legendaries:has_legendary_armor { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "armor.*": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_legendary_inventory { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "container.*": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_legendary_offhand { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "weapon.offhand": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_regen { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "effects": { 
            "minecraft:regeneration": {} 
        } 
    } 
} 
predicate legendaries:in_air { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_on_ground": false 
        } 
    } 
} 
predicate legendaries:not_sneaking { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_sneaking": false 
        } 
    } 
} 
predicate legendaries:on_ground { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_on_ground": true 
        } 
    } 
} 
predicate legendaries:sneaking { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_sneaking": true 
        } 
    } 
}

function legendaries:load:
    # Runs setup functions for all legendaries
    function legendaries:tidal_blade/setup
    function legendaries:ancient_helm/setup
    function legendaries:earthen_belt/setup
    function legendaries:ender_cloak/setup
    function legendaries:frenzy/setup
    function legendaries:tempest_boots/setup
    function legendaries:storms_edge/setup

    # Set up scoreboards
    scoreboard objectives add settings dummy

    # For scaling cooldowns correctly
    scoreboard players set $ticksPerSecond settings 20

    tellraw @a ["",{color:"gold",bold:true,text:"Magician's Legendary Items"},{color:"yellow",text:" Pack has loaded!"}]

function legendaries:tick:

    # All legendaries tick functions
    function legendaries:legendary_glowing
    function legendaries:tempest_boots/tick
    function legendaries:ender_cloak/tick
    function legendaries:ancient_helm/tick
    function legendaries:frenzy/tick
    function legendaries:tidal_blade/tick
    function legendaries:earthen_belt/tick
    function legendaries:storms_edge/tick

    # Give glowing to all players who have a legendary
    execute as @a[predicate=legendaries:has_legendary_inventory] run effect give @s glowing 1 0 true
    execute as @a[predicate=legendaries:has_legendary_armor] run effect give @s glowing 1 0 true
    execute as @a[predicate=legendaries:has_legendary_offhand] run effect give @s glowing 1 0 true

function legendaries:give_all:
    function legendaries:tidal_blade/give
    function legendaries:frenzy/give
    function legendaries:ancient_helm/give
    function legendaries:ender_cloak/give
    function legendaries:earthen_belt/give
    function legendaries:tempest_boots/give
    function legendaries:storms_edge/give
