import legendaries:tidal_blade as tidal_blade
import legendaries:ancient_helm as ancient_helm
import legendaries:earthen_belt as earthen_belt

# Genral predicates
predicate legendaries:has_legendary_armor {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "slots": {
      "armor.*": {
        "predicates": {
          "minecraft:custom_data": {
            "legendary": true
          }
        }
      }
    }
  }
}
predicate legendaries:has_legendary_inventory {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "slots": {
      "container.*": {
        "predicates": {
          "minecraft:custom_data": {
            "legendary": true
          }
        }
      }
    }
  }
}
predicate legendaries:has_legendary_offhand {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "slots": {
      "weapon.offhand": {
        "predicates": {
          "minecraft:custom_data": {
            "legendary": true
          }
        }
      }
    }
  }
}
predicate legendaries:has_regen {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "effects": {
      "minecraft:regeneration": {}
    }
  }
}
predicate legendaries:in_air {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "flags": {
      "is_on_ground": false
    }
  }
}
predicate legendaries:not_sneaking {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "flags": {
      "is_sneaking": false
    }
  }
}
predicate legendaries:on_ground {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "flags": {
      "is_on_ground": true
    }
  }
}
predicate legendaries:sneaking {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "flags": {
      "is_sneaking": true
    }
  }
}

function legendaries:load:
    # Runs setup functions for all legendaries
    function legendaries:tidal_blade/setup
    function legendaries:ancient_helm/setup
    function legendaries:earthen_belt/setup

    # Set up scoreboards
    scoreboard objectives add fall_distance dummy
    scoreboard objectives add settings dummy
    scoreboard objectives add frenzy_cooldown dummy
    scoreboard objectives add frenzy_cooldown_seconds dummy
    scoreboard objectives add frenzy_cooldown_seconds_old dummy
    scoreboard objectives add ender_cloak_raycast dummy

    # For scaling cooldowns correctly
    scoreboard players set $ticksPerSecond settings 20

    # Max distance ender cloak ability works from (set in raycast function)
    scoreboard players add $enderCloakMaxRaycast ender_cloak_raycast 0

    # Damage Mult is divided by scale so 25 would be 2.5 damage per block fallen
    scoreboard players set $speedBootsDamageMult settings 25
    scoreboard players set $speedBootsDamageMultScale settings 10

    # Minimum fall needed to trigger speed boots explosion
    scoreboard players set $speedBootsMinFall settings 5

    # If the speed boots explosion should display damage numbers (0 = false, 1 = true)
    scoreboard players set $speedBootsDisplayDamage settings 0

    tellraw @a ["",{color:"gold",bold:true,text:"Magician's Legendary Items"},{color:"yellow",text:" Pack has loaded!"}]

function legendaries:tick:
    function legendaries:legendary_glowing
    function legendaries:speed_boots/tick
    function legendaries:ender_cloak/tick
    function legendaries:ancient_helm/tick
    function legendaries:frenzy/tick
    function legendaries:tidal_blade/tick
    function legendaries:earthen_belt/tick
