import legendaries:tidal_blade as tidal_blade
import legendaries:ancient_helm as ancient_helm
import legendaries:earthen_belt as earthen_belt
import legendaries:ender_cloak as ender_cloak
import legendaries:frenzy as frenzy
import legendaries:tempest_boots as tempest_boots
import legendaries:storms_edge as storms_edge
import legendaries:terraprisma as terraprisma
import legendaries:recluse_shield as recluse_shield
import legendaries:enigma as enigma

# Genral predicates
predicate legendaries:has_legendary_armor { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "armor.*": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_legendary_inventory { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "container.*": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_legendary_offhand { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "slots": { 
            "weapon.offhand": { 
                "predicates": { 
                    "minecraft:custom_data": { 
                        "legendary": true 
                    } 
                } 
            } 
        } 
    } 
} 
predicate legendaries:has_regen { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "effects": { 
            "minecraft:regeneration": {} 
        } 
    } 
} 
predicate legendaries:in_air { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_on_ground": false 
        } 
    } 
} 
predicate legendaries:not_sneaking { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_sneaking": false 
        } 
    } 
} 
predicate legendaries:on_ground { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_on_ground": true 
        } 
    } 
} 
predicate legendaries:sneaking { 
    "condition": "minecraft:entity_properties", 
    "entity": "this", 
    "predicate": { 
        "flags": { 
            "is_sneaking": true 
        } 
    } 
}
predicate legendaries:not_wearing_armor {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "slots": {
            "armor.head": {
                "items": "air"
            },
            "armor.chest": {
                "items": "air"
            },
            "armor.legs": {
                "items": "air"
            },
            "armor.feet": {
                "items": "air"
            }
        }
    }
}

# Genral item modifires
item_modifier legendaries:clear_consumable {
    "function": "minecraft:set_components",
    "components": {
        "!minecraft:consumable": {}
    }
}
item_modifier legendaries:make_consumable {
    "function": "minecraft:set_components",
    "components": {
        "minecraft:consumable": {
            "consume_seconds": 1000000000,
            "animation": "none",
            "has_consume_particles": false
        }
    }
}

function legendaries:load:
    # Runs setup functions for all legendaries
    function legendaries:tidal_blade/setup
    function legendaries:ancient_helm/setup
    function legendaries:earthen_belt/setup
    function legendaries:ender_cloak/setup
    function legendaries:frenzy/setup
    function legendaries:tempest_boots/setup
    function legendaries:storms_edge/setup
    function legendaries:terraprisma/setup
    function legendaries:recluse_shield/setup
    function legendaries:enigma/setup

    # Set up scoreboards
    scoreboard objectives add settings dummy
    scoreboard objectives add id dummy

    # Adds id counter if not already there
    scoreboard players add $id_counter id 0

    # For scaling cooldowns correctly
    scoreboard players set $ticksPerSecond settings 20

    tellraw @a ["",{color:"gold",bold:true,text:"Magician's Legendary Items"},{color:"yellow",text:" Pack has loaded!"}]

function legendaries:tick:

    # All legendaries tick functions
    function legendaries:legendary_glowing
    function legendaries:tempest_boots/tick
    function legendaries:ender_cloak/tick
    function legendaries:ancient_helm/tick
    function legendaries:frenzy/tick
    function legendaries:tidal_blade/tick
    function legendaries:earthen_belt/tick
    function legendaries:storms_edge/tick
    function legendaries:terraprisma/tick
    function legendaries:recluse_shield/tick
    function legendaries:enigma/tick

    # Give glowing to all players who have a legendary
    # execute as @a[predicate=legendaries:has_legendary_inventory] run effect give @s glowing 1 0 true
    # execute as @a[predicate=legendaries:has_legendary_armor] run effect give @s glowing 1 0 true
    # execute as @a[predicate=legendaries:has_legendary_offhand] run effect give @s glowing 1 0 true

    # Handles displaying cooldowns
    execute as @a function legendaries:cooldown_display

    # Handles the custom player id system
    function legendaries:id_system
    

function legendaries:give_all:
    function legendaries:tidal_blade/give
    function legendaries:frenzy/give
    function legendaries:ancient_helm/give
    function legendaries:ender_cloak/give
    function legendaries:earthen_belt/give
    function legendaries:tempest_boots/give
    function legendaries:storms_edge/give
    function legendaries:terraprisma/give
    function legendaries:recluse_shield/give
    function legendaries:enigma/give


function legendaries:cooldown_display:
    # Generates the cooldown msg for all legendaries and displays it

    # Ancient Helm Text
    if entity @s[tag=ancient_helm_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s ancient_helm_cooldown_seconds = @s ancient_helm_cooldown
        scoreboard players operation @s ancient_helm_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"| "},{color:"dark_aqua",text:"Eldritch Shriek: ",extra:[{score:{name:"@s",objective:"ancient_helm_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Ender Cloak Text
    if entity @s[tag=ender_cloak_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s ender_cloak_cooldown_seconds = @s ender_cloak_cooldown
        scoreboard players operation @s ender_cloak_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"| "},{color:"dark_purple",text:"Ender Step: ",extra:[{score:{name:"@s",objective:"ender_cloak_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Enigma Text
    if entity @s[tag=enigma_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s enigma_cooldown_seconds = @s enigma_cooldown
        scoreboard players operation @s enigma_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"| "},{color:"dark_purple",text:"Abyssal Rune: ",extra:[{score:{name:"@s",objective:"enigma_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Frenzy Text
    if entity @s[tag=frenzy_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s frenzy_cooldown_seconds = @s frenzy_cooldown
        scoreboard players operation @s frenzy_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"|"},{color:"gold",text:" Raging Flame: ",extra:[{score:{name:"@s",objective:"frenzy_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Recluse Shield Text
    if entity @s[tag=recluse_shield_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s recluse_shield_cooldown_seconds = @s recluse_shield_cooldown
        scoreboard players operation @s recluse_shield_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"| "},{color:"gray",text:"Ensnare: ",extra:[{score:{name:"@s",objective:"recluse_shield_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Terraprisma Text
    if entity @s[tag=terraprisma_on_cooldown]:

        # Convert the cooldown from tick to seconds
        scoreboard players operation @s terraprisma_cooldown_seconds = @s terraprisma_cooldown
        scoreboard players operation @s terraprisma_cooldown_seconds /= $ticksPerSecond settings

        # Adds the text to the cooldown msg
        data modify storage legendaries:text cooldown append value ["",{color:"white",text:"|"},{color:"#CDF0E7",text:" Fractured Soul: ",extra:[{score:{name:"@s",objective:"terraprisma_cooldown_seconds"}},"s "]}]

        # Add has cooldown tag
        tag @s add has_cooldown
    
    # Adds the final | to the end of the msg if there are any cooldowns active right now
    if entity @s[tag=has_cooldown] run data modify storage legendaries:text cooldown append value {color:"white",text:"|"}

    # Displays cooldwon text
    function legendaries:cooldown_display_macro with storage legendaries:text

    # Clears old cooldwon text and tag
    data remove storage legendaries:text cooldown
    tag @s remove has_cooldown

function legendaries:cooldown_display_macro:
    # Displays the given cooldown text
    $title @s actionbar $(cooldown)


function legendaries:id_system:

    # Adds all player not on the id scoreboard to it
    execute as @a run scoreboard players add @s id 0

    # Gives an id to all player without an id 
    execute as @a[scores={id=0}]:

        # Copy fake players id to current player
        scoreboard players operation @s id = $id_counter id

        # Increase fake players score by 1
        scoreboard players add $id_counter id 1
