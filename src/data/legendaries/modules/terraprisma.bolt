import math

# Settings
ability_cooldown_seconds = 90 # Seconds
ability_effect_duration_seconds = 20 # Seconds, Should not be higher than 60 or the cooldown
effect_armor_reduction = 3
effect_damage_boost = 3
hits_for_smite = 5
smite_damage = 27

# Some timings converted to ticks
ability_cooldown = ability_cooldown_seconds * 20
ability_effect_duration = ability_effect_duration_seconds * 20

# For displaying the proper cooldown in item description
ability_cooldown_text = f"{ability_cooldown_seconds} Seconds"
if ability_cooldown_seconds > 60:
    minutes = math.floor(ability_cooldown_seconds / 60)
    seconds = ability_cooldown_seconds % 60
    ability_cooldown_text = f"{minutes} Minute"
    if minutes > 1:
        ability_cooldown_text += "s"
    if seconds != 0:
        ability_cooldown_text += f" {seconds} Second"
        if seconds > 1:
            ability_cooldown_text += "s"

advancement legendaries:terraprisma_right_click {
    "criteria": {
        "using_item": {
            "trigger": "minecraft:using_item",
            "conditions": {
                "item": {
                    "predicates": {
                        "minecraft:custom_data": "{terraprisma:1b}"
                    }
                }
            }
        }
    },
    "rewards": {
        "function": "legendaries:terraprisma/on_right_click"
    }
}
advancement legendaries:terraprisma_get_hit_by_ability {
    "criteria": {
        "get_hit": {
            "trigger": "minecraft:entity_hurt_player",
            "conditions": {
                "damage": {
                    "blocked": false,
                    "source_entity": {
                        "type": "minecraft:player",
                        "nbt": "{Tags:[\"terraprisma_ability_charged\"]}",
                        "slots": {
                            "weapon.mainhand": {
                                "predicates": {
                                    "minecraft:custom_data": {
                                        "terraprisma": true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "rewards": {
        "function": "legendaries:terraprisma/on_get_hit_by_ability"
    }
}
advancement legendaries:terraprisma_get_hit {
    "criteria": {
        "get_hit": {
            "trigger": "minecraft:entity_hurt_player",
            "conditions": {
